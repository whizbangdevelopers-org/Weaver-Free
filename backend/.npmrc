# An install whose dependency carries an install script that package.json's allowScripts does not
# name, or approves only at another version, FAILS before any script runs (ESTRICTALLOWSCRIPTS),
# instead of running it with a warning that nothing keeps. So no dependency's install script runs
# here unless it was reviewed at that version. audit:install-scripts fails without this line.
#
# This is a workspace member, and `npm --prefix <this directory> install` treats it as a project of
# its own: it reads this file and this package.json's allowScripts, not the root's. Install from
# the root (`npm --prefix <root> install -w <this package's name> <pkg>`); from here strict refuses
# any script-bearing dependency, because this package.json names none.
#
# This file said `loglevel=error` until 2026-11-10, which hid every npm warning, that one included.
strict-allow-scripts=true
